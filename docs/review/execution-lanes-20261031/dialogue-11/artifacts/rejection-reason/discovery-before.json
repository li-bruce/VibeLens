{
  "schema": "business-discovery/v1",
  "title": "Team File Review",
  "goal": "Share team files with designated accounts after a colleague approves them; require login for file access.",
  "networks": [
    {
      "id": "file_review_flow",
      "title": "文件审核与定向分享",
      "actors": [
        "Uploader",
        "Reviewer",
        "Recipient"
      ],
      "trigger": "A team member uploads a file.",
      "outcome": "The assigned colleague approves or ends the file workflow. Only the uploader shares approved files with one recipient. Login and explicit actor permissions control metadata and download access. The uploader may withdraw a pending file, ending that workflow and reviewer access while retaining uploader access.",
      "nodes": [
        {
          "id": "sign_in",
          "label": "登录",
          "kind": "action",
          "source_refs": [
            "U001"
          ],
          "model_nodes": [
            "sign_in"
          ]
        },
        {
          "id": "upload_file",
          "label": "上传并指定一位同事",
          "kind": "action",
          "source_refs": [
            "U001"
          ],
          "model_nodes": [
            "upload_file"
          ]
        },
        {
          "id": "pending_review",
          "label": "待指定同事审核",
          "kind": "state",
          "source_refs": [
            "U001"
          ],
          "model_nodes": [
            "pending_review"
          ]
        },
        {
          "id": "review_file",
          "label": "指定同事审核",
          "kind": "action",
          "source_refs": [
            "U001"
          ],
          "model_nodes": [
            "review_file"
          ]
        },
        {
          "id": "approved",
          "label": "审核通过",
          "kind": "state",
          "source_refs": [
            "U001"
          ],
          "model_nodes": [
            "approved"
          ]
        },
        {
          "id": "share_file",
          "label": "上传者分享给一个接收人",
          "kind": "action",
          "source_refs": [
            "U001"
          ],
          "model_nodes": [
            "share_file"
          ]
        },
        {
          "id": "access_file",
          "label": "查看信息或下载",
          "kind": "action",
          "source_refs": [
            "U001"
          ],
          "model_nodes": [
            "access_file"
          ]
        },
        {
          "id": "review_not_approved",
          "label": "未通过：流程结束",
          "kind": "state",
          "source_refs": [
            "U001"
          ],
          "model_nodes": [
            "review_not_approved"
          ]
        },
        {

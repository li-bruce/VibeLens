          ],
          "model_nodes": [
            "assigned_reviewer"
          ]
        },
        {
          "id": "uploader_access",
          "label": "上传者始终可读；审核人撤回后不可读",
          "kind": "condition",
          "source_refs": [
            "U001",
            "U004"
          ],
          "model_nodes": [
            "uploader_access"
          ]
        },
        {
          "id": "withdraw_file",

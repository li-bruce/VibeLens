          "source_refs": [
            "U004"
          ]
        },
        {
          "id": "flow_withdrawn",
          "from": "withdraw_file",
          "to": "withdrawn",
          "relation": "flow",
          "label": "撤回后结束；本版不再提交",
          "source_refs": [
            "U004"
          ]
        },
        {
          "id": "guard_withdrawn_access",
          "from": "withdrawn",
          "to": "access_file",
          "relation": "guard",
          "label": "保留文件；仅上传者可读取",
          "source_refs": [
            "U004"
          ]
        }
      ]
    }

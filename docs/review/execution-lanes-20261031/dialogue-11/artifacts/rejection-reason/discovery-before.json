  "decisions": [
    {
      "id": "D_REVIEWER",
      "topic": "authority",
      "question": "审核人怎么确定：上传者每次指定一位同事，还是固定审核人？",
      "why": "Determines which colleague is authorized to review the file.",
      "affects": [
        "review_file",
        "flow_wait_reviewer"
      ],
      "blocking": true,
      "status": "resolved",
      "priority": 1,
      "source_refs": [
        "U001"
      ],
      "resolution": {
        "kind": "user_answer",
        "text": "Confirmed by the current delegated scenario request U001; business user simulated by the coordinating AI.",

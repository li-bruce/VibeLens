    {
      "id": "D_ACCESS",
      "topic": "authority",
      "question": "权限怎么分：谁能发起分享？上传者、审核人和接收人分别可以查看文件信息、下载或再次分享到什么程度？",
      "why": "Determines share authority and file metadata/content access for each actor.",
      "affects": [
        "share_file",
        "access_file",
        "guard_approval_share",
        "guard_recipient_access"
      ],
      "blocking": true,
      "status": "resolved",
      "priority": 1,
      "source_refs": [
        "U001",
        "U004"
      ],
      "resolution": {
        "kind": "user_answer",
        "text": "撤回后就结束这次流程，这一版先不做再次提交。文件保留，上传的人仍然可以查看和下载；指定审核人不再看到待审核任务，也不能查看或下载。只允许上传的人撤回，而且必须还是待审核状态。",
        "source_refs": [
          "U004"
        ]
      },
      "requirements": [
        "R_SHARE",
        "R_ACCESS"
      ],
      "model_nodes": [
        "share_file",
        "access_file"
      ],
      "checks": [
        "workflow-business"
      ],
      "links": {
        "requirements": [
          "R_SHARE",
          "R_ACCESS"
        ],
        "model_nodes": [
          "share_file",
          "access_file"
        ],
        "checks": [
          "workflow-business"
        ]
      }
    },

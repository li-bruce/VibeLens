          ]
        },
        {
          "id": "guard_login_access",
          "from": "sign_in",
          "to": "access_file",
          "relation": "guard",
          "label": "访问必须已登录",
          "source_refs": [
            "U001"
          ]
        },
        {
          "id": "guard_reviewer_selection",
          "from": "assigned_reviewer",
          "to": "upload_file",
          "relation": "guard",
          "label": "从已有用户中选择一位其他同事",
          "source_refs": [
            "U001"
          ]
        },
        {
          "id": "guard_uploader_reviewer_access",
          "from": "uploader_access",
          "to": "access_file",
          "relation": "guard",
          "label": "上传者始终可读；审核人仅未撤回时可读",
          "source_refs": [
            "U001",
            "U004"
          ]
        },
        {
          "id": "flow_pending_withdraw",
          "from": "pending_review",
          "to": "withdraw_file",

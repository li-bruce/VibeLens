      ],
      "asked_in": [
        "A01_D_RECIPIENTS"
      ]
    },
    {
      "id": "D_MODE",
      "topic": "other",
      "question": "项目采用哪种方式：drive（由状态声明驱动流程），还是 observe（业务代码自行运行，图负责观察）？两者都会维护图和监测。",
      "why": "VibeLens requires an explicit development-mode choice before behavior implementation.",
      "affects": [
        "upload",
        "approve",
        "share",
        "download",
        "revoke"
      ],
      "blocking": true,
      "status": "open",
      "priority": 1,

  "decisions": [
    {
      "id": "D_AUTHORITY",
      "topic": "authority",
      "question": "审核通过后，由谁选择接收人并发起共享？谁可以撤销共享？",
      "why": "The request names a reviewer but does not assign sharing or revocation authority.",
      "affects": [
        "share",
        "revoke"
      ],
      "blocking": true,
      "status": "open",
      "priority": 1,
      "source_refs": [
        "U0",
        "I_DRAFT"
      ],
      "asked_in": [
        "A01_D_AUTHORITY"
      ]
    },
    {
      "id": "D_RECIPIENTS",
      "topic": "authority",
      "question": "共享只允许指定的站内账号下载，还是任何拿到链接的已登录同事都能下载？",
      "why": "Recipient identity determines notification delivery and download authorization.",
      "affects": [
        "share",
        "notify",
        "download"
      ],
      "blocking": true,
      "status": "open",
      "priority": 1,
      "source_refs": [
        "U0",

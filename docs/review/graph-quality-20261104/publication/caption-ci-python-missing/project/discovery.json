  "decisions": [
    {
      "id": "D_MODE",
      "topic": "other",
      "question": "VibeLens 的两种接入方式都会维护流程图和运行记录：drive 让程序按状态声明执行；observe 让程序自己处理业务，VibeLens 观察实际执行。这个工程选哪一种？",
      "why": "The explicit mode choice determines whether the application executes the state declaration or exposes its own authoritative execution.",
      "affects": [
        "upload_file",
        "review_file",
        "share_file",
        "recipient_access"
      ],
      "blocking": true,
      "status": "resolved",
      "priority": 1,
      "source_refs": [
        "U_INITIAL"
      ],
      "asked_in": [
        "A_MODE"
      ],
      "options": [
        {
          "id": "observe",
          "label": "Observe application execution",
          "effect": "The application owns its business logic; VibeLens observes actual execution."
        },
        {
          "id": "drive",
          "label": "Execute the state declaration",
          "effect": "A project-local executor consumes the state declaration; VibeLens records execution."
        }
      ],
      "resolution": {
        "kind": "user_answer",
        "text": "Use drive mode.",
        "source_refs": [
          "U_DETAIL",
          "U_PANEL"
        ]
      }
    },
    {
      "id": "D_AUTHORITY",
      "topic": "authority",
      "question": "你在第二项回答中的“管理员”具体指什么？它是否修改了你前面“从已有用户中选审核人，不能审核自己上传的文件”的规则？",
      "why": "Uploader assignment and sharing authority are answered. The later word administrator is ambiguous about reviewer scope or a self-review exception.",
      "affects": [
        "review_file",
        "share_file",
        "pending_to_review"
      ],
      "blocking": true,
      "status": "resolved",
      "priority": 2,
      "source_refs": [
        "U_INITIAL",
        "U_DETAIL",
        "U_PANEL"
      ],
      "asked_in": [
        "A_AUTHORITY",
        "A_ADMIN"
      ],
      "resolution": {
        "kind": "user_answer",
        "text": "The uploader selects a reviewer from existing users. Nobody may review their own upload. The uploader selects one recipient and shares after approval. The latest direct reply identifies administrator as a typo; no administrator-only reviewer restriction is adopted.",
        "source_refs": [
          "U_DETAIL",
          "U_CORRECTION"
        ]
      }
    },
    {
      "id": "D_ACCESS",
      "topic": "scope",
      "question": "你说的“访问文件”需要哪些能力：查看文件信息、下载、网页预览？另外，上传者和审核人在审核通过前是否可以读取文件内容？",
      "why": "Recipient access capabilities and pre-approval content access have distinct permission rules.",
      "affects": [
        "upload_file",
        "review_file",
        "recipient_access",
        "share_to_access"
      ],
      "blocking": true,
      "status": "resolved",
      "priority": 3,
      "source_refs": [
        "U_INITIAL"
      ],
      "asked_in": [
        "A_ACCESS"
      ],
      "resolution": {
        "kind": "user_answer",
        "text": "File information and download only. No web preview. Uploader and assigned reviewer can download before approval. A recipient needs approval and an actual share addressed to that person.",
        "source_refs": [
          "U_DETAIL",
          "U_PANEL"
        ]
      }
    },
    {
      "id": "D_ACCOUNTS",
      "topic": "scope",
      "question": "How are accounts supplied in this local trial?",
      "why": "Preserve the explicitly supplied preset-account scope without building registration or account-management pages.",
      "affects": [
        "signed_in",
        "upload_file"
      ],
      "blocking": false,
      "status": "resolved",
      "source_refs": [
        "U_ADMIN_FORWARD"
      ],
      "resolution": {
        "kind": "user_answer",
        "text": "Use preset accounts. No registration or account-management pages in this iteration.",
        "source_refs": [
          "U_ADMIN_FORWARD"
        ]
      }
    }
  ],

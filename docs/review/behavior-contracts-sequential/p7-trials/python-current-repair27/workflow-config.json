    "source_scope": {
      "roots": [
        "."
      ],
      "require_symbol_classification": true,
      "prune": [
        {
          "path": ".venv",
          "category": "dependency",
          "reason": "Project-local application dependencies"
        },
        {
          "path": "var",
          "category": "artifact",
          "reason": "Application database, uploads and prepared results; no source code planned here"
        },
        {
          "path": "review/tool-cache",
          "category": "dependency",
          "reason": "Pinned external viewer dependency cache"
        },
        {
          "path": "review/runtime",
          "category": "artifact",
          "reason": "Runtime verification artifacts"
        },
        {
          "path": "bo_stategraph/__init__.py",
          "category": "dependency",
          "reason": "Managed native VibeLens adapter; canonical bytes checked independently by integration.json."
        },
        {
          "path": "bo_stategraph/bo_contracts.py",
          "category": "dependency",
          "reason": "Managed native VibeLens adapter; canonical bytes checked independently by integration.json."
        },

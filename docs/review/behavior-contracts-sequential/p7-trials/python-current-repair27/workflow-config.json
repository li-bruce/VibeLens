        },
        {
          "path": "bo_stategraph/bo_capture.py",
          "category": "dependency",
          "reason": "Managed native VibeLens adapter; canonical bytes checked independently by integration.json."
        },
        {
          "path": "review",
          "category": "artifact",
          "reason": "Original verification records, screenshots, dependency cache and archives; no application source lives here."
        },
        {
          "path": "initial-v1",
          "category": "artifact",
          "reason": "Immutable baseline and verification receipts for the initial change; no application source lives here."
        },
        {
          "path": "cancel-queued-v1",
          "category": "artifact",
          "reason": "Immutable baseline and verification receipts for this change; no application source lives here."
        },
        {
          "path": "download-preparation-refactor-v1",
          "category": "artifact",
          "reason": "Immutable baseline and verification receipts for this change; no application source lives here."
        },
        {
          "path": ".stategraph/repair26-provider-maintenance",
          "category": "artifact",
          "reason": "Immutable baseline and verification receipts for this change; no application source lives here."
        }
      ]
    },
    "stategraph": {
      "module": "bo_stategraph/__init__.py",
      "development_mode": "drive",
      "execution_mode": "drive",
      "decision_source": "user",
      "decision": "我选择状态图驱动执行（drive）。"
    },
    "require_mapping_witnesses": true,
    "require_probe_health": true,
    "require_observation_closure": true,
    "mapping_contract": "mapping.json",
    "acceptance": "acceptance.json",
    "probe_modes": [
      "on",
      "off",
      "fault"
    ],
    "probe_callees": [
      "self.bo.bo_call",
      "self.bo.bo_transition",
      "self.bo.bo_before_transition",
      "self.bo_probe.span",
      "probe.record",
      "service.bo_probe.span"
    ],
    "required_probes": [
      {
        "symbol": "app/service.py::Service.upload_file",
        "node": "upload_file",
        "phase": "return"
      },
      {
        "symbol": "app/downloads.py::DownloadOperations.start_preparation",
        "node": "start_preparation",
        "phase": "return"
      },
      {
        "symbol": "app/downloads.py::DownloadOperations.complete_preparation",
        "node": "complete_preparation",
        "phase": "return"
      },
      {
        "symbol": "app/downloads.py::DownloadOperations.cancel_download",
        "node": "cancel_download",
        "phase": "return"
      }
    ],
    "required_runtime_probes": [
      {
        "case": "normal",
        "node": "upload_file",
        "phase": "return"
      },
      {
        "case": "normal",
        "node": "state_commit",
        "phase": "commit"
      },
      {
        "case": "queued_revoked",
        "node": "start_preparation",
        "phase": "return"
      },
      {
        "case": "started_revoked",
        "node": "collect_result",
        "phase": "return"
      },
      {
        "case": "normal",
        "node": "cancel_download",
        "phase": "return"
      },
      {
        "case": "normal",
        "node": "api:POST:/downloads/<job_id>/cancel",
        "phase": "return"
      },
      {
        "case": "queued_revoked",
        "node": "cancel_download",
        "phase": "return"
      },
      {
        "case": "queued_revoked",
        "node": "api:POST:/downloads/<job_id>/cancel",
        "phase": "return"
      },
      {
        "case": "started_revoked",
        "node": "cancel_download",
        "phase": "return"
      },
      {
        "case": "started_revoked",
        "node": "api:POST:/downloads/<job_id>/cancel",
        "phase": "return"
      }
    ],
    "observations_command": [
      "{python}",
      "-B",
      "-X",
      "utf8",
      "tooling/observe.py"
    ],
    "test_commands": [
      [
        "{python}",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "tests.test_business",
        "-v"
      ],
      [
        "{python}",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "tests.test_http_observation",
        "-v"
      ],
      [
        "{python}",
        "-B",
        "-X",
        "utf8",
        "tooling/strict_checks.py",
        "docs"
      ],
      [
        "{python}",
        "-B",
        "-X",
        "utf8",
        "tooling/strict_checks.py",
        "api-check"
      ]
    ],
    "timeout_seconds": 180
  },
  "integration": {
    "schema": "vibelens-integration/v1",
    "language": "python",
    "protocols": {

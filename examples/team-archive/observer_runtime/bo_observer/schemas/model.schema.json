{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "intent",
    "source_files",
    "nodes",
    "edges",
    "overview",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "action",
              "function",
              "decision",
              "wait",
              "effect",
              "data",
              "state"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://github.com/li-bruce/SoftwareStatusObserverSkill/protocol/source-ref",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "symbol"
            ]
          },
          "represents": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "symbol",
              "parameter"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "parameter": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "observation_root": {
            "type": "boolean",
            "description": "A source-bound external point notification, not an internal observation missing its invocation owner."
          },
          "lifecycle": {
            "$ref": "#/$defs/nodeLifecycle"
          },
          "state_model_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "type",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "flow",
              "data",
              "guard",
              "contains",
              "resource",
              "join",
              "maps"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "schema",
        "revision",
        "stage",
        "inputs",
        "predicates",
        "nodes",
        "operations"
      ],
      "properties": {
        "schema": {
          "const": "bo-policy/v1"
        }
      }
    },
    "machine": {
      "type": "object",
      "required": [
        "engine",
        "version",
        "states",
        "values",
        "initial",
        "transitions",
        "events",
        "context"
      ]
    },
    "presentation": {
      "type": "object",
      "properties": {
        "names": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "concepts": {
              "$ref": "#/properties/presentation/properties/names/properties/nodes"
            },
            "nodes": {
              "type": "object",
              "propertyNames": {
                "minLength": 1
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                  },
                  {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": false,
                    "properties": {
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                      },
                      "zh-CN": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                      }
                    }
                  }
                ]
              }
            },
            "edges": {
              "type": "object",
              "propertyNames": {
                "minLength": 1
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                  },
                  {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": false,
                    "properties": {
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                      },
                      "zh-CN": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                      }
                    }
                  }
                ]
              }
            },
            "states": {
              "type": "object",
              "propertyNames": {
                "minLength": 1
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                  },
                  {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": false,
                    "properties": {
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                      },
                      "zh-CN": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                      }
                    }
                  }
                ]
              }
            },
            "events": {
              "type": "object",
              "propertyNames": {
                "minLength": 1
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                  },
                  {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": false,
                    "properties": {
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                      },
                      "zh-CN": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "machines": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "engine",
          "version",
          "states",
          "values",
          "initial",
          "transitions",
          "events",
          "context"
        ]
      }
    },
    "networks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "layer",
          "nodes"
        ]
      }
    }
  },
  "$id": "https://github.com/li-bruce/SoftwareStatusObserverSkill/protocol/model",
  "$defs": {
    "nodeLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "states",
        "bindings"
      ],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "kind": {
                "enum": [
                  "active",
                  "waiting",
                  "ended"
                ]
              }
            }
          }
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "state",
              "boundary"
            ],
            "properties": {
              "phase": {
                "enum": [
                  "enter",
                  "return",
                  "read",
                  "decision",
                  "wait",
                  "commit",
                  "change",
                  "error"
                ]
              },
              "state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "boundary": {
                "enum": [
                  "start",
                  "update",
                  "end"
                ]
              },
              "when": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "direction",
                  "field",
                  "equals"
                ],
                "properties": {
                  "direction": {
                    "enum": [
                      "in",
                      "out"
                    ]
                  },
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "equals": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ],
                    "maxLength": 256,
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "machine"
      ],
      "not": {
        "required": [
          "machines"
        ]
      }
    },
    {
      "required": [
        "machines"
      ],
      "not": {
        "required": [
          "machine"
        ]
      }
    }
  ]
}

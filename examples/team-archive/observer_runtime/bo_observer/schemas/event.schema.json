{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/li-bruce/SoftwareStatusObserverSkill/protocol/event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "protocol": {
      "const": "bo-event/v1"
    },
    "schema_version": {
      "const": 3
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "model_revision": {
      "type": "string",
      "minLength": 1
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "context_only": {
      "type": "boolean"
    },
    "context_boundary": {
      "enum": [
        "start",
        "end"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "node": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "enter",
        "return",
        "read",
        "decision",
        "wait",
        "commit",
        "change",
        "error"
      ]
    },
    "entity": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "application",
        "entity",
        "attempt"
      ]
    },
    "call_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_call_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_event_id": {
      "description": "Actual enclosing invocation entry; independent of the observed entity identity.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512
    },
    "basis": {
      "type": "object"
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object"
    },
    "depends": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://github.com/li-bruce/SoftwareStatusObserverSkill/protocol/dependency",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "data",
              "control",
              "trigger",
              "recheck"
            ]
          }
        },
        "required": [
          "event",
          "type"
        ]
      }
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "const": "span"
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^(?!0{16}$)[0-9a-f]{16}$"
        },
        "trace_flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "parent_span_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!0{16}$)[0-9a-f]{16}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tracestate": {
          "type": "string",
          "maxLength": 512
        },
        "links": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_build_id": {"type": "string", "minLength": 1, "maxLength": 256},
              "trace_id": {
                "type": "string",
                "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
              },
              "span_id": {
                "type": "string",
                "pattern": "^(?!0{16}$)[0-9a-f]{16}$"
              },
              "relation": {
                "enum": [
                  "trigger",
                  "data",
                  "control",
                  "recheck"
                ]
              }
            },
            "required": [
              "trace_id",
              "span_id"
            ]
          }
        }
      },
      "required": [
        "trace_id",
        "span_id",
        "trace_flags"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "objects": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "id",
              "type",
              "role"
            ]
          }
        },
        "actor": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "kind": {
              "enum": [
                "user",
                "service"
              ]
            }
          },
          "required": [
            "id",
            "kind"
          ]
        }
      }
    }
  },
  "required": [
    "protocol",
    "schema_version",
    "project_id",
    "model_revision",
    "build_id",
    "run_id",
    "producer_id",
    "id",
    "seq",
    "node",
    "phase",
    "entity",
    "attempt",
    "scope",
    "call_id",
    "parent_call_id",
    "basis",
    "inputs",
    "outputs",
    "depends",
    "observed_at"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "context_only"
        ],
        "properties": {
          "context_only": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "context_boundary"
        ],
        "properties": {
          "inputs": {
            "maxProperties": 0
          },
          "outputs": {
            "maxProperties": 0
          },
          "basis": {
            "maxProperties": 0
          },
          "depends": {
            "maxItems": 0
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "revision"
              ]
            },
            {
              "required": [
                "provenance"
              ]
            },
            {
              "required": ["exception"]
            }
          ]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "context_boundary": {
                  "const": "start"
                }
              }
            },
            "then": {
              "properties": {
                "phase": {
                  "const": "enter"
                }
              }
            },
            "else": {
              "properties": {
                "phase": {
                  "enum": [
                    "return",
                    "error",
                    "commit",
                    "change"
                  ]
                }
              }
            }
          }
        ]
      },
      "else": {
        "not": {
          "required": [
            "context_boundary"
          ]
        }
      }
    }
  ]
}

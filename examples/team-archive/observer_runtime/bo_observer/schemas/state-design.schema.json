{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/li-bruce/VibeLens/protocol/state-design",
  "type": "object",
  "required": [
    "id",
    "subject",
    "states",
    "initial",
    "events",
    "context",
    "guards",
    "effects",
    "transitions",
    "source_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "initial": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object"
    },
    "events": {
      "type": "object"
    },
    "context": {
      "type": "object"
    },
    "guards": {
      "type": "object"
    },
    "effects": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/li-bruce/VibeLens/protocol/concept-snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope",
    "records",
    "semantic_revision"
  ],
  "properties": {
    "schema": {
      "const": "bo-concept-snapshot/v1"
    },
    "scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "records": {
      "type": "object"
    },
    "semantic_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/li-bruce/VibeLens/protocol/discovery/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "goal",
    "sources",
    "networks",
    "decisions",
    "objects",
    "facts",
    "state_models",
    "crosslinks",
    "applicability",
    "expectations",
    "confirmations",
    "construction"
  ],
  "properties": {
    "presentation": {
      "type": "object"
    },
    "schema": {
      "const": "business-discovery/v3"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "layout_id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "networks": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "routing": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "business_intent",
                  "technical_choice",
                  "implementation_fact",
                  "analysis_assumption",
                  "verification_gap"
                ]
              },
              "owner": {
                "enum": [
                  "human",
                  "agent",
                  "checker"
                ]
              },
              "checker": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "stage": {
                "enum": [
                  "before_implementation",
                  "during_coding",
                  "before_acceptance",
                  "before_analysis"
                ]
              },
              "trigger": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "authority": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "user",
                      "project_rule",
                      "delegated",
                      "engineering"
                    ]
                  },
                  "source_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "scope_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "kind",
                  "source_refs",
                  "scope_refs"
                ]
              },
              "obligation_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "evidence_required": {
                "type": "array",
                "items": {
                  "enum": [
                    "conversation_answer",
                    "source_reference",
                    "runtime_witness",
                    "independent_assertion",
                    "checker_receipt"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "invalidated_by": {
                "type": "array",
                "items": {
                  "enum": [
                    "meaning",
                    "source",
                    "environment",
                    "adapter",
                    "property",
                    "build"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "wording": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "en": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "business": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "technical": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "business",
                      "technical"
                    ]
                  },
                  "zh-CN": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "business": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "technical": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "business",
                      "technical"
                    ]
                  }
                },
                "required": []
              },
              "when": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "decision": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "choice": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "decision",
                    "choice"
                  ]
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "kind",
              "owner",
              "stage",
              "trigger",
              "authority",
              "obligation_refs",
              "evidence_required",
              "invalidated_by"
            ]
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "affects": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "reply_to": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "kind": {
                  "enum": [
                    "partial",
                    "contradiction"
                  ]
                }
              },
              "required": [
                "id",
                "text",
                "source_refs",
                "affects",
                "kind"
              ]
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "resolution": {
            "type": "object",
            "properties": {
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "source_reference",
                        "runtime_witness",
                        "independent_assertion",
                        "checker_receipt"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "scope_refs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "kind",
                    "path",
                    "sha256",
                    "scope_refs"
                  ]
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "choice": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "state_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "subject",
          "states",
          "initial",
          "events",
          "context",
          "guards",
          "effects",
          "transitions",
          "source_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "initial": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "object"
          },
          "events": {
            "type": "object"
          },
          "context": {
            "type": "object"
          },
          "guards": {
            "type": "object"
          },
          "effects": {
            "type": "object"
          },
          "execution": {
            "type": "object"
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object"
                }
              ]
            }
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "crosslinks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "expectations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confirmations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "policy": {
      "type": "object"
    },
    "relation_rules": {
      "type": "object"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^target:[^\\s]+$"
              },
              "kind": {
                "enum": [
                  "business_network",
                  "state_model",
                  "rule_operation",
                  "interaction"
                ]
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "scope_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "unresolved": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "promoted_to": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "id",
              "kind",
              "meaning",
              "source_refs",
              "scope_refs",
              "unresolved"
            ]
          }
        },
        "obligations": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "source_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "meaning": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "kind": {
                    "const": "model"
                  },
                  "target_ref": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "target_kind": {
                    "enum": [
                      "business_network",
                      "state_model",
                      "rule_operation",
                      "interaction"
                    ]
                  }
                },
                "required": [
                  "id",
                  "source_refs",
                  "meaning",
                  "kind",
                  "target_ref",
                  "target_kind"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "source_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "meaning": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "kind": {
                    "const": "relation"
                  },
                  "from_ref": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "to_ref": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "relation": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "id",
                  "source_refs",
                  "meaning",
                  "kind",
                  "from_ref",
                  "to_ref",
                  "relation"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "source_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "meaning": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "kind": {
                    "const": "state_owner"
                  },
                  "object_ref": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "id",
                  "source_refs",
                  "meaning",
                  "kind",
                  "object_ref"
                ]
              }
            ]
          }
        },
        "presentations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "source_evidence": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "snapshot": {
                "type": "object"
              },
              "visible_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "explained_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "omitted_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "targets": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "source_refs",
              "source_evidence",
              "scope",
              "snapshot",
              "visible_refs",
              "explained_refs",
              "omitted_refs",
              "targets"
            ]
          }
        }
      },
      "required": [
        "targets",
        "obligations",
        "presentations"
      ]
    },
    "participation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "knowledge_domains": {
          "type": "array",
          "items": {
            "enum": [
              "product",
              "business",
              "architecture",
              "development",
              "testing"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "explanation_depth": {
          "enum": [
            "outcome",
            "technical",
            "mixed"
          ]
        },
        "preferred_participation": {
          "enum": [
            "questions",
            "review_groups"
          ]
        },
        "language": {
          "enum": [
            "en",
            "zh-CN"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "source_refs"
      ]
    }
  }
}

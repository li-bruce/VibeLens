{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/li-bruce/VibeLens/protocol/discovery/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "goal",
    "sources",
    "networks",
    "decisions",
    "objects",
    "facts",
    "state_models",
    "crosslinks",
    "applicability",
    "expectations",
    "confirmations"
  ],
  "properties": {
    "schema": {
      "const": "business-discovery/v2"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "layout_id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "networks": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "state_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "subject",
          "states",
          "initial",
          "events",
          "context",
          "guards",
          "effects",
          "transitions",
          "source_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "initial": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "object"
          },
          "events": {
            "type": "object"
          },
          "context": {
            "type": "object"
          },
          "guards": {
            "type": "object"
          },
          "effects": {
            "type": "object"
          },
          "execution": {
            "type": "object"
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object"
                }
              ]
            }
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "crosslinks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "expectations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confirmations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "policy": {
      "type": "object"
    },
    "relation_rules": {
      "type": "object"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

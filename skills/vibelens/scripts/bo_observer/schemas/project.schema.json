{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/li-bruce/SoftwareStatusObserverSkill/protocol/project",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "bo-project/v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "selection": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://github.com/li-bruce/SoftwareStatusObserverSkill/protocol/selection",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "drive",
            "observe"
          ]
        },
        "source": {
          "const": "user"
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mode",
        "source",
        "answer",
        "locator"
      ]
    },
    "model": {
      "$ref": "https://github.com/li-bruce/SoftwareStatusObserverSkill/protocol/model"
    }
  },
  "required": [
    "protocol",
    "project_id",
    "selection",
    "model"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/li-bruce/VibeLens/protocol/event-batch",
  "description": "Transport wrapper only. Each original event also passes the event schema and semantic admission checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "events"],
  "properties": {
    "protocol": {"const": "bo-event-batch/v1"},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "object"}
    }
  }
}

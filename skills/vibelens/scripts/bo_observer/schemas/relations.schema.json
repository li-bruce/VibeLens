{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/li-bruce/VibeLens/protocol/relations",
  "$defs": {
    "context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "basis": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "bindings": {
          "type": [
            "object",
            "null"
          ]
        },
        "conditions": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge"
      ],
      "properties": {
        "edge": {
          "type": "object",
          "required": [
            "id",
            "from",
            "to",
            "type",
            "evidence"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "definition_key": {
          "type": "string",
          "minLength": 1
        },
        "independent": {
          "type": "boolean"
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "match"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "direct",
            "summary"
          ]
        },
        "transitive": {
          "type": "boolean"
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "origin": {
              "type": "string",
              "minLength": 1
            },
            "code_relation": {
              "type": "string",
              "minLength": 1
            },
            "data_relation": {
              "type": "string",
              "minLength": 1
            },
            "semantic_relation": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "result",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "definitions",
        "compositions"
      ],
      "properties": {
        "schema": {
          "const": "bo-relation-rules/v1"
        },
        "definitions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/definition"
          }
        },
        "compositions": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/composition"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "retained",
            "duplicate",
            "represented"
          ]
        },
        "reason": {
          "enum": [
            "same_definition",
            "unknown_relation",
            "direct_fact",
            "independent_evidence",
            "unknown_context",
            "no_equivalent_path",
            "search_budget",
            "cyclic_relation_family",
            "cyclic_witness",
            "registered_path"
          ]
        },
        "duplicate_of": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "leaf_path": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_work",
        "max_candidates"
      ],
      "properties": {
        "max_work": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "nodes",
        "rules",
        "entries",
        "decisions",
        "canonical_edges",
        "revision",
        "limits"
      ],
      "properties": {
        "schema": {
          "const": "bo-relation-index/v1"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "rules": {
          "$ref": "#/$defs/rules"
        },
        "entries": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "decisions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/decision"
          }
        },
        "canonical_edges": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/rules"
    },
    {
      "$ref": "#/$defs/entry"
    },
    {
      "$ref": "#/$defs/registry"
    }
  ]
}

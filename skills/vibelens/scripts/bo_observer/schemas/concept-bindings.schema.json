{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/li-bruce/VibeLens/protocol/concept-bindings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "semantic_revision",
    "primary_state_model",
    "objects",
    "business",
    "facts",
    "expectations",
    "crosslinks"
  ],
  "properties": {
    "schema": {
      "const": "bo-concept-bindings/v1"
    },
    "semantic_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "primary_state_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "objects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "object",
          "identity"
        ]
      }
    },
    "business": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "minItems": 1
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "node": {
              "type": "string",
              "minLength": 1
            },
            "direction": {
              "enum": [
                "in",
                "out"
              ]
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "basis_checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "case",
                  "path"
                ],
                "properties": {
                  "case": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "integer",
                          "minimum": 0
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "required": [
            "node",
            "direction",
            "field",
            "basis_checks"
          ]
        }
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "minItems": 1
      }
    },
    "crosslinks": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "relation": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "to": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "native_event": {
                "type": "string",
                "minLength": 1
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "relation",
              "from",
              "to",
              "native_event",
              "edges"
            ]
          }
        ]
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "minItems": 1
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "node",
          "event"
        ]
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": [
              "string",
              "null"
            ]
          },
          "field": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "node",
          "decision",
          "field"
        ]
      }
    },
    "transition_effects": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect",
            "edges",
            "completion"
          ],
          "properties": {
            "effect": {
              "type": "string",
              "minLength": 1
            },
            "edges": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "completion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "node",
                "phase",
                "field",
                "equals",
                "boundary",
                "expectation",
                "path"
              ],
              "properties": {
                "node": {
                  "type": "string",
                  "minLength": 1
                },
                "phase": {
                  "enum": [
                    "return",
                    "commit",
                    "change"
                  ]
                },
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "equals": {},
                "boundary": {
                  "type": "string",
                  "minLength": 1
                },
                "expectation": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "integer",
                        "minimum": 0
                      }
                    ]
                  }
                },
                "identity_field": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
